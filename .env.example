# ECLAIR — example environment configuration (M01 Foundation).
# Copy to `.env` and adjust. Placeholder values only — NO real secrets.
# Every variable below is read by src/eclair/config.py::load_config().
# Missing variables fall back to safe defaults (Ollama local is the permanent
# zero-cost fallback, Spec §4.11).

# --- Core application -------------------------------------------------------
# Deployment environment name (e.g. development, production).
ECLAIR_ENVIRONMENT=development
# Enable debug behaviour (truthy: 1, true, yes — case-insensitive).
ECLAIR_DEBUG=false

# --- LLM provider (generic) -------------------------------------------------
# Provider a consumer should build by default (free-form string).
ECLAIR_LLM_ACTIVE_PROVIDER=ollama
# Generic request timeout in seconds (must be > 0).
ECLAIR_LLM_TIMEOUT_SECONDS=30
# Generic retry count (must be >= 0).
ECLAIR_LLM_RETRIES=2

# --- Ollama (permanent zero-cost local fallback, Spec §4.11) ---------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Gemini (optional; free quota only) ------------------------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=

# --- Groq (optional; free quota only) --------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=

# --- OpenRouter (optional; free quota only) --------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
